{
  "schema": "bgnbd-near-one-synthetic-posterior-integral-v1",
  "input_semantics": "Each decimal JSON numeric input denotes its nearest binary64, integrated at its exact rational value. Offset labels are descriptive; a_hex pins actual a.",
  "primary_source": "https://doi.org/10.1287/mksc.1040.0098",
  "derivation": "Conditional active lambda posterior is Gamma(r+x,alpha+T), dropout posterior Beta(a,b+x). E future|active = integral (1-(1+p*h/(alpha+T))^-(r+x))/p times the beta posterior. Evaluate numerator with expm1/log1p. Multiply by posterior active probability.",
  "method": "mpmath tanh-sinh posterior integral; no Rust or native evaluation",
  "tolerances": {
    "scalar": {
      "absolute": 1e-12,
      "relative": 1e-10
    }
  },
